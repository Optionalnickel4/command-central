# OpenClaw gateway — for the assistant panel (routes through OpenClaw
# instead of calling Claude directly; requires
# gateway.http.endpoints.chatCompletions.enabled=true in openclaw.json)
OPENCLAW_GATEWAY_URL=http://10.0.0.x:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_MODEL=openclaw/default

# Homelab data sources — see README "Wiring real data" section
PROMETHEUS_URL=http://10.0.0.4:9221
HOMELAB_MCP_URL=https://mcp.jushosting.dev/mcp
HOMELAB_MCP_TOKEN=

# Weather (open-meteo needs no key; swap in a provider that does if preferred)
WEATHER_LAT=39.9526
WEATHER_LON=-75.1652

# Calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# News
NEWS_API_KEY=
NEWS_TOPICS=tech,gaming
