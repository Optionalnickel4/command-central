# Command Central — environment template.
# Copy to .env.local and fill in what you have. Every panel degrades on its
# own, so partial configuration is fine: unset sources render an
# "unavailable" card and the rest of the dashboard keeps working.
#
# .env.local is gitignored. Keep it that way — real tokens live there only.

# --- Proxmox (the homelab panel) -----------------------------------------
# A read-only PVEAuditor API token. The client tolerates a self-signed cert.
# Without these three, the homelab panel and the ticker/pulse chrome go idle.
PROXMOX_API_URL=https://10.0.0.x:8006
PROXMOX_TOKEN_ID=user@pam!tokenname
PROXMOX_TOKEN_SECRET=

# --- Sol / OpenClaw assistant backend (optional) --------------------------
# The "SOL" toggle in the assistant panel SSHes to an OpenClaw host. Each key
# below is a SEPARATE key whose authorized_keys `command=` on the far side is
# locked to one wrapper. See README "The Sol backend" before setting these up.
OPENCLAW_SSH_HOST=10.0.0.152
# cc-agent — runs one agent turn. Used by app/api/chat/route.ts.
OPENCLAW_SSH_KEY=/home/builder/.ssh/openclaw_agent
# cc-stats — four read-only stat commands. Powers the /sol page.
OPENCLAW_STATS_KEY=/home/builder/.ssh/openclaw_stats
# cc-projects — cats one PROJECTS.md. RETIRED as a context source: project
# status now comes from the Obsidian vault mount below, not over SSH. These two
# still configure lib/projects.ts, which is left in the tree but is no longer
# wired into the assistant's context snapshot. Nothing reads them at runtime.
PROJECTS_SSH_KEY=/home/builder/.ssh/cc_projects
# PROJECTS_TTL_MS=600000

# --- Project context (the Obsidian vault) ---------------------------------
# The shared Obsidian vault is bind-mounted into this container; the assistant
# reads one markdown file per project out of it for project-status context,
# browses them at /vault, and can APPEND dated bullets under a `## Log` section
# once the user confirms each one. Writes are append-only and never rewrite a
# file — three parties edit these notes (this app, OpenClaw on 152, and the
# human in Obsidian), so a read-modify-write would eat somebody's edit. If the
# mount is absent or read-only the snapshot omits the project section, /vault
# shows an empty state, and a write returns a clean error; chat keeps working.
VAULT_DIR=/mnt/vault/Projects
# Optional: override the vault cache TTL in ms (default 10 min).
# VAULT_TTL_MS=600000

# --- Claude assistant backend (optional) ----------------------------------
# The "CLAUDE" toggle shells out to the Claude Code CLI, using whatever login
# already exists for the user the service runs as. No API key is involved.
# Only set this if `claude` is not on PATH.
# CLAUDE_BIN=claude

# --- Voice (optional) ------------------------------------------------------
# A local Piper TTS HTTP service. Without it the assistant still replies in
# text; only spoken output is lost.
PIPER_URL=http://127.0.0.1:5303

# --- Esports (vlr-api) -----------------------------------------------------
# The esports panels need vlr-api, a separate self-hosted service (not bundled
# here). Clone and run it, then point this at your instance:
#   https://github.com/Optionalnickel4/vlr-api
# Until this is set, every esports panel degrades to unavailable.
VLR_API_URL=http://10.0.0.x:8000

# Master switch for the whole esports section. Defaults to ON when unset, so
# leave it alone if you run vlr-api. Setting it to false is the clean way to
# run without vlr-api: the panels, the /esports/player route, the command-bar
# entry and every vlr-api call (assistant context and chat lookups included)
# disappear, and the dashboard reflows without them. The dashboard page is
# prerendered, so run `npm run build` after changing this, not just a restart.
# ENABLE_ESPORTS=false

# --- Media stack (optional, all read-only) ---------------------------------
# Each service is independent — configure any subset. A missing one shows a
# single "unavailable" card on /media and affects nothing else.
JELLYFIN_URL=
JELLYFIN_API_KEY=
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USER=
QBITTORRENT_PASS=
SEERR_URL=
SEERR_API_KEY=

# --- Weather (open-meteo) --------------------------------------------------
# Open-Meteo needs no API key and no signup, so these coordinates are the whole
# configuration. Without BOTH of them the panel shows "not configured" (a setup
# step, not a fault) and nothing else is affected.
WEATHER_LAT=39.9526
WEATHER_LON=-75.1652
# Optional display label under the temperature. Open-Meteo returns coordinates,
# not a place name, so without this the panel shows the coordinates rather than
# claiming a city it was never told.
WEATHER_LOCATION=Philadelphia
# Optional: override the current-conditions cache TTL in ms (default 10 min).
# Open-Meteo's current block only moves every 15 min; polling harder buys
# nothing and is impolite to a free, keyless service.
# WEATHER_TTL_MS=600000

# --- News (RSS) ------------------------------------------------------------
# The news panel merges public RSS/Atom feeds. No API key, no signup and no
# rate tier to blow — which is why it beats a news API here. The default set
# (tech + gaming) lives in DEFAULT_FEEDS in lib/news.ts:
#   The Verge, Ars Technica, Hacker News, PC Gamer, Polygon
# Feeds degrade individually: one publisher moving or 403ing its feed costs
# that feed's items only, and the panel notes "4/5 feeds". Nothing is required
# below — set these only to change the defaults.
#
# Optional: replace the feed set wholesale with a comma-separated list of feed
# URLs. A value with no usable URLs falls back to the defaults rather than
# blanking the panel.
# NEWS_FEEDS=https://www.theverge.com/rss/index.xml,https://hnrss.org/frontpage
# Optional: how many headlines the panel shows (default 6).
# NEWS_LIMIT=6
# Optional: override the feed cache TTL in ms (default 15 min). RSS publishers
# don't want frequent polling and news doesn't move that fast — leave it be.
# NEWS_TTL_MS=900000
#
# NOTE: the old NEWS_API_KEY / NEWS_TOPICS placeholders are gone. The panel is
# RSS-based, so there is no key, and the topic list is the feed list above.

# --- Calendar (Google Calendar, read-only) ---------------------------------
# Needs setup in the Google Cloud console before these mean anything — this is
# the one source here that can't be configured from a URL alone:
#   1. Create (or reuse) a project, and enable the Google Calendar API on it.
#   2. OAuth consent screen: External, add your own Google account as a TEST
#      USER (that's what makes it work without Google verification), scope
#      https://www.googleapis.com/auth/calendar.readonly
#   3. Create OAuth client credentials, type "Web application", and register
#      the Authorized redirect URI EXACTLY as:
#          https://jarvis.jushosting.dev/api/calendar/callback
#      https, no trailing slash — Google compares it character-for-character.
#   4. Put the client ID and secret below, then restart the service.
#   5. Visit /api/calendar/connect on the dashboard host and approve. The
#      callback shows the refresh token ONCE; paste it in as the third var and
#      restart again. It is never written to disk by the app.
# Until all three are set the panel shows "not connected" (a setup step, not a
# fault) with a link to start the flow. Nothing else is affected.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Optional: override the callback URI if this app is hosted somewhere else. It
# must match the OAuth client's registered redirect URI exactly.
# GOOGLE_CALENDAR_REDIRECT_URI=https://jarvis.jushosting.dev/api/calendar/callback
# Optional: how many events the panel shows (default 5) and how far ahead to
# look in days (default 7).
# CALENDAR_LIMIT=5
# CALENDAR_DAYS=7
# Optional: override the events cache TTL in ms (default 10 min).
# CALENDAR_TTL_MS=600000

